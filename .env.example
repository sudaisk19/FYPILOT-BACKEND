# ─── Environment Mode ──────────────────────────────────────────
ENV=development

# ─── Database (SQLAlchemy) ─────────────────────────────────────
DATABASE_URL=

# ─── Supabase SDK ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ─── JWT Authentication ────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256

# ─── Session Secret (for OAuth state cookies) ─────────────────
SESSION_SECRET=your-session-secret-key-for-oauth-state

# ─── Mailer Settings (Ethereal Email) ─────────────────────────
MAILER_PROVIDER=ethereal
ETHEREAL_SMTP_HOST=smtp.ethereal.email
ETHEREAL_SMTP_PORT=587
ETHEREAL_SMTP_USER=your-ethereal-username
ETHEREAL_SMTP_PASS=your-ethereal-password

# ─── Frontend / OAuth Settings ────────────────────────────────
FRONTEND_APP_URL=http://localhost:3000
OAUTH_REDIRECT_ORIGIN=http://127.0.0.1:8000

# ─── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── GitHub OAuth2 (optional) ─────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Feature Flags ────────────────────────────────────────────
ENABLE_REQUEST_ID=true
ENABLE_SECURITY_HEADERS=true
ENABLE_SESSIONS=true




