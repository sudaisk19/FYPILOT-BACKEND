# ─── Environment Mode ──────────────────────────────────────────
ENV=development

# ─── Database (SQLAlchemy) ─────────────────────────────────────
DATABASE_URL=

# ─── Supabase SDK ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ─── JWT Authentication ────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256

# ─── Session Secret (for OAuth state cookies) ─────────────────
SESSION_SECRET=your-session-secret-key-for-oauth-state

# ─── Mail (Mailtrap default for dev) ─────────────────────────
MAILER_PROVIDER=mailtrap
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# Optional footer line in transactional emails
# EMAIL_SUPPORT_CONTACT=support@fypilot.tech

# --- Resend (later) — uncomment in app/core/config.py + app/services/mailer.py ---
# MAILER_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=FYPilot <onboarding@resend.dev>

# ─── Frontend / OAuth Settings ────────────────────────────────
FRONTEND_APP_URL=http://localhost:3000
OAUTH_REDIRECT_ORIGIN=http://127.0.0.1:8000

# ─── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── GitHub OAuth2 (optional) ─────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Feature Flags ────────────────────────────────────────────
ENABLE_REQUEST_ID=true
ENABLE_SECURITY_HEADERS=true
ENABLE_SESSIONS=true

# ─── Bulk Import Settings ─────────────────────────────────
# Token for GitHub Actions cron authentication
CRON_TOKEN=your-secure-cron-token-here

# Fernet key for encrypting temp passwords (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
APP_ENCRYPTION_KEY=your-fernet-key-here

# Number of items to process per cron tick (default: 50)
BULK_IMPORT_BATCH_SIZE=50

# Hours until temp passwords expire for download (default: 24)
TEMP_PASSWORD_TTL_HOURS=24





# ─── AI Recommender Service ───────────────────────────────
# URL of the external AI Recommender microservice
# Local development: http://localhost:8001
# Production: http://your-recommender-droplet-ip:8000 or http://ai-recommender-service:8000 (Docker network)
AI_RECOMMENDER_URL=http://localhost:8001

# HTTP timeout for AI Recommender service calls (seconds)
AI_RECOMMENDER_TIMEOUT=30.0

# AI Recommender Middleware Settings (all optional, showing defaults)
# AI_RATE_LIMIT_REQUESTS=10       # Max requests per user per window
# AI_RATE_LIMIT_WINDOW=60         # Rate limit window in seconds
# AI_CACHE_TTL=300                # Response cache TTL in seconds (5 minutes)
# AI_CIRCUIT_FAILURE_THRESHOLD=5  # Failures before opening circuit breaker
# AI_CIRCUIT_RECOVERY_TIMEOUT=30  # Seconds before circuit breaker tries recovery
