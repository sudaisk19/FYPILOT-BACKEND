# ── Environment Mode ───────────────────────────────────
# ENV=development → plaintext passwords (fast local dev)
# ENV=production  → bcrypt passwords (secure prod)
ENV=development

# ── Database (SQLAlchemy) ─────────────────────────────
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dbname                      

# ── Supabase SDK (if you prefer Supabase over SQLAlchemy)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_KEY=<your-supabase-api-key>

# ── JWT Authentication ─────────────────────────────────
JWT_SECRET=<your-jwt-secret>
JWT_ALGORITHM=HS256

# ── OpenAI / LLM Settings ─────────────────────────────
# (if you use them…)
