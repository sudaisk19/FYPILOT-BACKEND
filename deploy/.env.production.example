# Copy to /opt/fypilot-backend/.env on the DigitalOcean Droplet.
# Do not commit real values. REDIS_URL is overridden by docker-compose.prod.yml for the backend service.

ENV=production

# ─── PostgreSQL (e.g. Supabase) ───────────────────────────────
DATABASE_URL=postgresql://user:pass@db.xxx.supabase.co:5432/postgres?sslmode=require

# ─── Supabase client ─────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-long-random
JWT_ALGORITHM=HS256
SESSION_SECRET=change-me-different-long-random

# ─── MongoDB (e.g. Atlas) ────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=fypilot

# Redis: Compose sets REDIS_URL=redis://redis:6379/0 for the backend container.
# You can omit REDIS_URL here or keep the same value for local tooling consistency.

# ─── Mail (production provider) ──────────────────────────────
MAILER_PROVIDER=mailtrap
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# ─── URLs (HTTPS in production) ──────────────────────────────
FRONTEND_APP_URL=https://app.yourdomain.com
OAUTH_REDIRECT_ORIGIN=https://api.yourdomain.com

# ─── OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── LLM / GitHub Models (set what you use) ───────────────────
# GITHUB_OPENAI_TOKEN=
# GITHUB_DEEPSEEK_TOKEN=
# GITHUB_OPENAI_BASE_URL=https://models.github.ai/inference

# ─── Other app settings ──────────────────────────────────────
ENABLE_REQUEST_ID=true
ENABLE_SECURITY_HEADERS=true
ENABLE_SESSIONS=true

AI_RECOMMENDER_URL=https://your-recommender-host
CRON_TOKEN=rotate-me
APP_ENCRYPTION_KEY=

# Collaborative chat (optional overrides)
# CHAT_WORKER_TASKS=2
# CHAT_RATE_LIMIT_PER_MINUTE_USER=30
