TEST_AUTH_STUDENT_EMAIL=
TEST_AUTH_STUDENT_PASSWORD=
TEST_AUTH_SUPERVISOR_EMAIL=
TEST_AUTH_SUPERVISOR_PASSWORD=
TEST_AUTH_JURY_EMAIL=
TEST_AUTH_JURY_PASSWORD=
TEST_AUTH_ADMIN_EMAIL=
TEST_AUTH_ADMIN_PASSWORD=
